# Copy this file to .env and set your OpenRouter API key locally.
# Never commit .env or put a real key in this example file.
OPENROUTER_API_KEY=

# Optional model overrides. Use IDs from https://openrouter.ai/models.
# COUNCIL_MODELS=openai/gpt-6.1-sol,google/gemini-4-argon,anthropic/claude-sonnet-5.5,x-ai/grok-4.7
# CHAIRMAN_MODEL=google/gemini-4-argon
# TITLE_MODEL=google/gemini-3.5-flash-lite

# Per-model HTTP timeout for reasoning models; title generation uses 30 seconds.
# OPENROUTER_TIMEOUT_SECONDS=180
